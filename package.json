{
  "name": "bob-maxey-ford-protect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/generate-routes.mjs",
    "test": "node --test src/*.test.js",
    "audit:release": "node scripts/release-audit.mjs",
    "check": "npm test && npm run build && npm run audit:release",
    "test:browser": "playwright test",
    "test:cross-browser": "playwright test --config=playwright.cross-browser.config.js",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "lucide-react": "^1.38.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
